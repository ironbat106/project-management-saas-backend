# Server 
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
 
# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/pm_saas?schema=public"
 
# Bcrypt
BCRYPT_SALT_ROUNDS=10
 
# JWT
JWT_ACCESS_SECRET=your-access-token-secret
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
 
# Google Social Login
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
 
# Admin account 
ADMIN_NAME="Platform Admin"
ADMIN_EMAIL=admin@pmsaas.com
ADMIN_PASSWORD=ChangeThisPassword123!
 
# Redis
REDIS_URL="redis://default:password@localhost:6379"
 
# Stripe 
STRIPE_SECRET_KEY=stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=stripe_webhook_key_here
STRIPE_PRO_PRICE_ID=stripe_pro_price_id_here
STRIPE_BUSINESS_PRICE_ID=stripe_business_price_id_here
